{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "This project uses Laravel Zero framework. All commands are built using Laravel Zero's Command class."
    ],
    "mcp": {
        "spotify": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "spotify",
                "mcp:start",
                "spotify"
            ]
        }
    },
    "languageServers": {
        "php": {
            "intelephense": {
                "stubs": ["laravel"]
            }
        }
    }
}
