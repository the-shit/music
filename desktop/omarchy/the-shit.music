    def hotkey_strip(self):
        self.hotkey_bar = Gtk.FlowBox()
        self.hotkey_bar.set_selection_mode(Gtk.SelectionMode.NONE)
        self.hotkey_bar.set_max_children_per_line(6)
        self.hotkey_bar.set_column_spacing(16)
        self.hotkey_bar.set_row_spacing(6)
        self.hotkey_bar.set_margin_start(14)
        self.hotkey_bar.set_margin_end(14)
        self.hotkey_bar.set_margin_top(8)
        self.hotkey_bar.set_margin_bottom(8)
        self.hotkey_bar.set_visible(False)
        return self.hotkey_bar

    def paint_hotkeys(self):
        if self.hotkey_bar is None:
            return
        self.clear_box(self.hotkey_bar)
        chips = [(f"Alt+{number}", title) for number, title, _handler in self.hot_slots]
        chips.extend([("Alt+←", "Previous"), ("Alt+→", "Next")])
        for chord, title in chips:
            chip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            key = Gtk.Label(label=chord, css_classes=["mark"])
            name = Gtk.Label(label=title, css_classes=["song"])
            name.set_ellipsize(Pango.EllipsizeMode.END)
            name.set_max_width_chars(22)
            chip.append(key)
            chip.append(name)
            self.hotkey_bar.append(chip)

    def set_hotkeys_visible(self, visible):
        if self.hotkey_bar is None:
            return
        if visible:
            self.paint_hotkeys()
        self.hotkey_bar.set_visible(visible)

    def activate_hot_slot(self, index):
        if index < 0 or index >= len(self.hot_slots):
            return
        _number, _title, handler = self.hot_slots[index]
        handler(None)

    def body(self):
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        body.set_vexpand(True)

        rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, css_classes=["rail"])
        rail.set_size_request(320, -1)
        rail.set_hexpand(False)
        rail.set_margin_top(8)
        self.rail_box = rail
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(rail)
        scroll.set_size_request(int(260 * self.scale), -1)
        self.rail_scroll = scroll
        scroll.set_hexpand(False)
        scroll.set_vexpand(True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add_css_class("rail")
        body.append(scroll)

        split = Gtk.Box(css_classes=["rule"])
        split.set_size_request(1, -1)
        body.append(split)

        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.stack.add_named(self.playing_page(), "playing")
        self.stack.add_named(self.playlist_page(), "playlist")
        self.stack.set_visible_child_name("playing")
        body.append(self.stack)
        return body

    def playing_page(self):
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        main.set_margin_top(24)
        main.set_margin_bottom(18)
        main.set_margin_start(28)
        main.set_margin_end(28)
