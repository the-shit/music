#!/usr/bin/env python3
"""Tiled music window. Class the-shit.music. Chrome follows Omamail and the live theme."""

import base64
import faulthandler
import json
import os
import subprocess
import threading
import time
import traceback
import urllib.error
import urllib.parse
import urllib.request

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkWayland", "4.0")

from gi.repository import Gdk, GdkWayland, GLib, Gtk, Pango
import dbus
from dbus.mainloop.glib import DBusGMainLoop

DBusGMainLoop(set_as_default=True)
LOG_PATH = os.path.expanduser("~/.local/state/the-shit-music.log")

APP_ID = "the-shit.music"
SPOTIFY = os.path.expanduser("~/.config/composer/vendor/bin/spotify")
CONFIG = os.path.expanduser("~/.config/spotify-cli")
FONT = '"JetBrainsMono Nerd Font", monospace'
ZOOM_PATH = os.path.expanduser("~/.local/state/the-shit-music-zoom")
ZOOM_MIN = 0.85
ZOOM_MAX = 2.0
ZOOM_STEP = 0.15

FALLBACK = {
    "background": "#140c18",
    "dark_background": "#0c0810",
    "foreground": "#f0e2d0",
    "dark_foreground": "#8a7088",
    "accent": "#e46592",
    "selection": "#3a2438",
    "muted": "#7a5e78",
}


def theme_colors():
    colors = dict(FALLBACK)
    path = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
    try:
        lines = open(path, encoding="utf-8")
    except OSError:
        return colors
    with lines:
        for line in lines:
            if "=" not in line or line.lstrip().startswith("#"):
                continue
            key, value = line.split("=", 1)
            value = value.strip().strip('"')
            if value.startswith("#") and len(value) >= 7:
                colors[key.strip()] = value[:7]
    return colors


def rgba(hex_color, alpha):
    red = int(hex_color[1:3], 16)
    green = int(hex_color[3:5], 16)
    blue = int(hex_color[5:7], 16)
    return f"rgba({red},{green},{blue},{alpha})"


def load_zoom():
    try:
        value = float(open(ZOOM_PATH, encoding="utf-8").read().strip())
    except (OSError, ValueError):
        return 1.25
    return min(ZOOM_MAX, max(ZOOM_MIN, value))


def px(size, scale):
    return max(11, round(size * scale))


def stylesheet(colors, scale):
    bg = colors["background"]
    ink = colors["foreground"]
    dim = colors["muted"]
    accent = colors["accent"]
    rail = colors["dark_background"]
    selected = colors["selection"]
    return f"""
    window {{ background: {bg}; }}
    label {{ font-family: {FONT}; font-size: {px(16, scale)}px; color: {ink}; }}
    .mark {{ color: {accent}; font-size: {px(22, scale)}px; }}
    .wordmark {{ color: {ink}; font-size: {px(20, scale)}px; }}
    .status {{ color: {dim}; font-size: {px(16, scale)}px; }}
    .caption {{ color: {dim}; font-size: {px(14, scale)}px; }}
    .track {{ color: {ink}; font-size: {px(28, scale)}px; }}
    .song {{ color: {ink}; font-size: {px(18, scale)}px; }}
    .artist {{ color: {dim}; font-size: {px(16, scale)}px; }}
    .line {{
      padding: 10px 8px;
      border-bottom: 1px solid {rgba(ink, 0.14)};
    }}
    progressbar {{ font-size: 0; }}
    progressbar trough {{
      min-height: 8px;
      background: {rgba(ink, 0.16)};
      border-radius: 0;
    }}
    progressbar progress {{
      background: {accent};
      border-radius: 0;
      min-height: 8px;
    }}
    .rule {{ background: {rgba(ink, 0.16)}; min-width: 1px; min-height: 1px; }}
    .rail {{ background: {rail}; }}
    entry {{
      background: {rail};
      color: {ink};
      caret-color: {accent};
      border: 1px solid {rgba(ink, 0.22)};
      border-radius: 0;
      padding: 6px 10px;
      min-height: 0;
      font-family: {FONT};
      font-size: {px(16, scale)}px;
    }}
    entry placeholder {{ color: {dim}; }}
    entry:focus {{ border-color: {accent}; }}
    button {{
      background: transparent;
      color: {dim};
      border: 1px solid {rgba(ink, 0.22)};
      border-radius: 0;
      padding: 6px 12px;
      font-family: {FONT};
      font-size: {px(15, scale)}px;
    }}
    button:hover {{ color: {ink}; border-color: {accent}; }}
    button.rail {{
      border: none;
      padding: 8px 14px;
      margin: 0;
    }}
    button.rail label {{ color: {dim}; }}
    button.rail:hover {{ background: {rgba(ink, 0.06)}; }}
    button.rail:hover label {{ color: {ink}; }}
    button.rail.selected {{ background: {selected}; }}
    button.rail.selected label {{ color: {ink}; }}
    """.encode()


def device_name():
    path = os.path.expanduser("~/.config/spotify-cli/spotifyd.conf")
    try:
        lines = open(path, encoding="utf-8")
    except OSError:
        return "Thor"
    with lines:
        for line in lines:
            if line.strip().startswith("device_name"):
                return line.split("=", 1)[1].strip().strip('"') or "Thor"
    return "Thor"


def spawn(*args):
    if not os.path.isfile(SPOTIFY):
        return
    subprocess.Popen(
        [SPOTIFY, *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def read_json(path):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save_token(data):
    path = os.path.join(CONFIG, "token.json")
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump({
            "access_token": data.get("access_token"),
            "refresh_token": data.get("refresh_token"),
            "expires_at": data.get("expires_at"),
        }, handle, indent=4)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def access_token():
    token = read_json(os.path.join(CONFIG, "token.json"))
    expires = token.get("expires_at") or 0
    if token.get("access_token") and expires > time.time() + 60:
        return token["access_token"]
    creds = read_json(os.path.join(CONFIG, "credentials.json"))
    refresh = token.get("refresh_token")
    client_id = creds.get("client_id")
    client_secret = creds.get("client_secret")
    if not refresh or not client_id or not client_secret:
        return token.get("access_token")
    basic = base64.b64encode(f"{client_id}:{client_secret}".encode()).decode()
    request = urllib.request.Request(
        "https://accounts.spotify.com/api/token",
        data=urllib.parse.urlencode({
            "grant_type": "refresh_token",
            "refresh_token": refresh,
        }).encode(),
        headers={
            "Authorization": f"Basic {basic}",
            "Content-Type": "application/x-www-form-urlencoded",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.load(response)
    except (OSError, json.JSONDecodeError, urllib.error.URLError):
        return token.get("access_token")
    token["access_token"] = payload.get("access_token")
    token["expires_at"] = int(time.time()) + int(payload.get("expires_in") or 3600)
    if payload.get("refresh_token"):
        token["refresh_token"] = payload["refresh_token"]
    if token.get("access_token"):
        save_token(token)
    return token.get("access_token")


RATE_LIMIT = os.path.join(CONFIG, "rate-limit.json")


def rate_limited():
    # Shared with the PHP CLI (SpotifyRateLimit): one 429 pauses every client of this app.
    return int(read_json(RATE_LIMIT).get("resumes_at") or 0) > time.time()


def note_rate_limit(retry_after):
    try:
        seconds = max(1, int(retry_after or 60))
    except (TypeError, ValueError):
        seconds = 60
    temporary = RATE_LIMIT + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump({"resumes_at": int(time.time()) + seconds}, handle)
    os.replace(temporary, RATE_LIMIT)


def api(method, url, token, body=None):
    if rate_limited():
        return None
    data = b"" if body is None and method in {"POST", "PUT"} else None
    if body is not None:
        data = json.dumps(body).encode()
    request = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        if exc.code == 429:
            note_rate_limit(exc.headers.get("Retry-After"))
            return None
        if exc.code == 401:
            return None
        raise
    if not raw:
        return {}
    return json.loads(raw)


def account_playlists():
    token = access_token()
    if not token:
        return []
    url = "https://api.spotify.com/v1/me/playlists?limit=50"
    found = []
    while url and len(found) < 200:
        page = api("GET", url, token)
        if page is None:
            token = access_token()
            page = api("GET", url, token) if token else None
        if not page:
            break
        for item in page.get("items") or []:
            if item and item.get("id") and item.get("name"):
                found.append({
                    "id": item["id"],
                    "name": str(item["name"]),
                    "uri": item.get("uri") or f"spotify:playlist:{item['id']}",
                    "count": int((item.get("tracks") or {}).get("total") or 0),
                })
        url = page.get("next")
    return found


def playlist_tracks(playlist_id):
    token = access_token()
    if not token:
        return []
    url = f"https://api.spotify.com/v1/playlists/{playlist_id}/tracks?limit=100"
    rows = []
    while url and len(rows) < 200:
        page = api("GET", url, token) or {}
        for item in page.get("items") or []:
            track = item.get("track") or {}
            uri = track.get("uri") or ""
            if not uri.startswith("spotify:track:"):
                continue
            artists = track.get("artists") or []
            rows.append({
                "uri": uri,
                "name": str(track.get("name") or "Track"),
                "artist": str(artists[0].get("name")) if artists else "",
            })
        url = page.get("next")
    return rows


def add_to_playlist(playlist_id, uri):
    token = access_token()
    if not token:
        return False
    return api(
        "POST",
        f"https://api.spotify.com/v1/playlists/{playlist_id}/tracks",
        token,
        {"uris": [uri]},
    ) is not None


def remove_from_playlist(playlist_id, uri):
    token = access_token()
    if not token:
        return False
    return api(
        "DELETE",
        f"https://api.spotify.com/v1/playlists/{playlist_id}/tracks",
        token,
        {"tracks": [{"uri": uri}]},
    ) is not None


def thor_device(token):
    devices = api("GET", "https://api.spotify.com/v1/me/player/devices", token) or {}
    chosen = None
    for device in devices.get("devices") or []:
        if device.get("name") == device_name():
            chosen = device
            break
    if chosen is None:
        for device in devices.get("devices") or []:
            if device.get("is_active"):
                chosen = device
                break
    if not chosen:
        return None, False
    return chosen.get("id"), bool(chosen.get("is_active"))


def start_on_thor(body):
    token = access_token()
    if not token:
        return False
    device_id, active = thor_device(token)
    if device_id and not active:
        api("PUT", "https://api.spotify.com/v1/me/player", token, {
            "device_ids": [device_id],
            "play": False,
        })
    url = "https://api.spotify.com/v1/me/player/play"
    if device_id:
        url += "?device_id=" + urllib.parse.quote(device_id)
    return api("PUT", url, token, body) is not None


def play_playlist(uri):
    return start_on_thor({"context_uri": uri})


def search_tracks(query):
    token = access_token()
    if not token:
        return []
    url = "https://api.spotify.com/v1/search?" + urllib.parse.urlencode({
        "q": query,
        "type": "track",
        "limit": 5,
    })
    payload = api("GET", url, token) or {}
    return (payload.get("tracks") or {}).get("items") or []


def search_catalog(query):
    token = access_token()
    if not token:
        return []
    url = "https://api.spotify.com/v1/search?" + urllib.parse.urlencode({
        "q": query,
        "type": "track,artist,playlist",
        "limit": 5,
    })
    payload = api("GET", url, token) or {}
    rows = []
    for track in (payload.get("tracks") or {}).get("items") or []:
        artists = track.get("artists") or []
        album = track.get("album") or {}
        detail = " · ".join(part for part in (
            artists[0].get("name") if artists else "",
            album.get("name") or "",
        ) if part)
        rows.append({
            "kind": "Track",
            "name": str(track.get("name") or "Track"),
            "detail": detail,
            "uri": track.get("uri") or "",
            "track": track,
        })
    for artist in (payload.get("artists") or {}).get("items") or []:
        rows.append({
            "kind": "Artist",
            "name": str(artist.get("name") or "Artist"),
            "detail": "Artist",
            "uri": artist.get("uri") or "",
            "artist_id": artist.get("id") or "",
        })
    for playlist in (payload.get("playlists") or {}).get("items") or []:
        if not playlist or not playlist.get("uri"):
            continue
        count = (playlist.get("tracks") or {}).get("total")
        detail = f"{count} songs" if isinstance(count, int) else "Playlist"
        rows.append({
            "kind": "Playlist",
            "name": str(playlist.get("name") or "Playlist"),
            "detail": detail,
            "uri": playlist.get("uri") or "",
        })
    return rows


def artist_top_track(artist_id):
    token = access_token()
    if not token or not artist_id:
        return None
    url = f"https://api.spotify.com/v1/artists/{artist_id}/top-tracks?market=US"
    payload = api("GET", url, token) or {}
    tracks = payload.get("tracks") or []
    return tracks[0] if tracks else None


def seek_to(ms):
    token = access_token()
    if not token:
        return False
    device_id, _active = thor_device(token)
    url = "https://api.spotify.com/v1/me/player/seek?position_ms=" + str(max(0, int(ms)))
    if device_id:
        url += "&device_id=" + urllib.parse.quote(device_id)
    return api("PUT", url, token) is not None


def set_stream_volume(percent):
    token = access_token()
    if not token:
        return False
    device_id, _active = thor_device(token)
    bounded = max(0, min(100, int(percent)))
    url = "https://api.spotify.com/v1/me/player/volume?volume_percent=" + str(bounded)
    if device_id:
        url += "&device_id=" + urllib.parse.quote(device_id)
    return api("PUT", url, token) is not None


def clock(ms):
    seconds = max(0, int(ms) // 1000)
    return f"{seconds // 60}:{seconds % 60:02d}"


def play_in_album(track):
    uri = track.get("uri") or ""
    album = (track.get("album") or {}).get("uri") or ""
    if album.startswith("spotify:album:") and uri:
        return start_on_thor({"context_uri": album, "offset": {"uri": uri}})
    if uri:
        return start_on_thor({"uris": [uri]})
    return False


def upcoming():
    token = access_token()
    if not token:
        return []
    payload = api("GET", "https://api.spotify.com/v1/me/player/queue", token) or {}
    current = (payload.get("currently_playing") or {}).get("uri") or ""
    seen = {current} if current else set()
    rows = []
    for item in payload.get("queue") or []:
        uri = item.get("uri") or ""
        if not uri or uri in seen or not uri.startswith("spotify:track:"):
            continue
        seen.add(uri)
        artists = item.get("artists") or []
        artist = artists[0].get("name") if artists else ""
        label = item.get("name") or "Track"
        if artist:
            label = f"{label} — {artist}"
        rows.append({"uri": uri, "label": label})
        if len(rows) == 20:
            break
    return rows


def enqueue(uri):
    if not uri:
        return "missing"
    current_rows = upcoming()
    token = access_token()
    if not token:
        return "missing"
    player = api("GET", "https://api.spotify.com/v1/me/player", token) or {}
    current = ((player.get("item") or {}).get("uri")) or ""
    if uri == current or any(row["uri"] == uri for row in current_rows):
        return "already"
    device_id, _active = thor_device(token)
    url = "https://api.spotify.com/v1/me/player/queue?uri=" + urllib.parse.quote(uri)
    if device_id:
        url += "&device_id=" + urllib.parse.quote(device_id)
    api("POST", url, token)
    return "added"


def playing_context():
    token = access_token()
    if not token:
        return ""
    player = api("GET", "https://api.spotify.com/v1/me/player", token) or {}
    context = player.get("context") or {}
    return str(context.get("uri") or "")


def note_failure():
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "a", encoding="utf-8") as handle:
        handle.write(time.strftime("%Y-%m-%d %H:%M:%S\n"))
        traceback.print_exc(file=handle)


def note_line(text):
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "a", encoding="utf-8") as handle:
        handle.write(time.strftime("%H:%M:%S ") + text + "\n")


def spotify():
    bus = dbus.SessionBus()
    names = [name for name in bus.list_names() if name.startswith("org.mpris.MediaPlayer2.spotify")]
    names.sort(key=lambda name: (0 if "spotifyd" in name else 1, name))
    if not names:
        return None, None
    obj = bus.get_object(names[0], "/org/mpris/MediaPlayer2")
    props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
    player = dbus.Interface(obj, "org.mpris.MediaPlayer2.Player")
    return props, player


def meta_text(props):
    empty = ("Nothing playing", "Thor", "", "Play", "Paused")
    if props is None:
        return empty
    try:
        metadata = props.Get("org.mpris.MediaPlayer2.Player", "Metadata")
        status = str(props.Get("org.mpris.MediaPlayer2.Player", "PlaybackStatus"))
    except dbus.DBusException:
        return empty
    title = str(metadata.get("xesam:title") or "Nothing playing")
    artists = metadata.get("xesam:artist") or []
    artist = str(artists[0]) if artists else device_name()
    album = str(metadata.get("xesam:album") or "")
    play = "Pause" if status == "Playing" else "Play"
    state = "Playing" if status == "Playing" else "Paused"
    return title, artist, album, play, state


class Music:
    def __init__(self):
        self.title = None
        self.artist = None
        self.album = None
        self.play = None
        self.play_buttons = []
        self.status = None
        self.rails = {}
        self.rail_box = None
        self.selected = None
        self.stack = None
        self.track_box = None
        self.playlist_title = None
        self.playlist_meta = None
        self.search = None
        self.zoom_label = None
        self.provider = None
        self.colors = None
        self.scale = 1.25
        self.note = None
        self.queue_box = None
        self.art = None
        self.art_url = ""
        self.progress = None
        self.next_label = None
        self.results = []
        self.result_index = 0
        self.results_box = None
        self.results_scroll = None
        self.search_timer = 0
        self.message_timer = 0
        self.track_length_ms = 0
        self.time_label = None
        self.seek = None
        self.volume = None
        self.device_label = None
        self.bar_art = None
        self.bar_title = None
        self.bar_artist = None
        self.queue_button = None
        self.add_button = None
        self.rail_scroll = None
        self.seen_workspace = None
        self.hot_slots = []
        self.hotkey_bar = None
        self.viz = None
        self.levels = [0.0] * 32
        self.stop_audio = False
        self.audio_proc = None
        self.loop = GLib.MainLoop()

    def run(self):
        GLib.set_prgname(APP_ID)
        colors = theme_colors()
        self.colors = colors
        self.scale = load_zoom()
        provider = Gtk.CssProvider()
        self.provider = provider
        provider.load_from_data(stylesheet(colors, self.scale))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        win = Gtk.Window(title="Music")
        win.set_default_size(980, 720)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(self.header())
        self.results_scroll = Gtk.ScrolledWindow()
        self.results_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.results_scroll.set_max_content_height(320)
        self.results_scroll.set_propagate_natural_height(True)
        self.results_scroll.set_visible(False)
        self.results_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.results_scroll.set_child(self.results_box)
        root.append(self.results_scroll)
        rule = Gtk.Box(css_classes=["rule"])
        rule.set_size_request(-1, 1)
        root.append(rule)
        middle = self.body()
        middle.set_vexpand(True)
        root.append(middle)
        rule2 = Gtk.Box(css_classes=["rule"])
        rule2.set_size_request(-1, 1)
        root.append(rule2)
        root.append(self.hotkey_strip())
        root.append(self.player_bar())
        win.set_child(root)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_window_key)
        keys.connect("key-released", self.on_window_key_release)
        win.add_controller(keys)
        wheel = Gtk.EventControllerScroll.new(
            Gtk.EventControllerScrollFlags.VERTICAL | Gtk.EventControllerScrollFlags.DISCRETE
        )
        wheel.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        wheel.connect("scroll", self.on_zoom_scroll)
        win.add_controller(wheel)
        win.connect("realize", self.on_realize)
        win.connect("map", self.on_realize)
        win.connect("close-request", self.on_close)
        note_line("present")
        win.present()
        GLib.timeout_add(1000, self.remember_workspace)
        GLib.idle_add(lambda: win.set_focus(None))
        GLib.idle_add(self.load_playlists)
        GLib.idle_add(self.paint_queue)
        GLib.timeout_add(1000, self.refresh)
        GLib.timeout_add(15000, self.paint_queue)
        GLib.timeout_add(33, self.tick_viz)
        threading.Thread(target=self.listen, daemon=True).start()
        self.refresh()
        self.loop.run()

    def header(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.set_margin_start(14)
        bar.set_margin_end(14)
        bar.set_margin_top(10)
        bar.set_margin_bottom(10)

        mark = Gtk.Label(label="♪", css_classes=["mark"])
        mark.set_valign(Gtk.Align.CENTER)
        word = Gtk.Label(label="Music", css_classes=["wordmark"])
        word.set_valign(Gtk.Align.CENTER)
        bar.append(mark)
