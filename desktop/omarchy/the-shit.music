        self.viz = Gtk.DrawingArea()
        self.viz.set_hexpand(True)
        self.viz.set_size_request(-1, 160)
        self.viz.set_draw_func(self.draw_viz)
        main.append(self.viz)
        return main

    def draw_viz(self, _area, ctx, width, height):
        ink = (self.colors or FALLBACK)["accent"]
        red = int(ink[1:3], 16) / 255
        green = int(ink[3:5], 16) / 255
        blue = int(ink[5:7], 16) / 255
        levels = self.levels
        count = len(levels) or 1
        gap = 6
        bar_w = max(2, (width - gap * (count + 1)) / count)
        for index, level in enumerate(levels):
            bar_h = max(3, min(1.0, level) * (height - 10))
            ctx.set_source_rgba(red, green, blue, 0.35 + 0.65 * min(1.0, level))
            ctx.rectangle(gap + index * (bar_w + gap), height - bar_h, bar_w, bar_h)
            ctx.fill()

    def tick_viz(self):
        if self.viz is not None:
            self.viz.queue_draw()
        return True

    def listen(self):
        try:
            import numpy as np
        except ImportError:
            note_line("no numpy, bars stay down")
            return
        while not self.stop_audio:
            proc = None
            try:
                sink = subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()
                proc = subprocess.Popen(
                    ["pw-cat", "-r", "--target", sink + ".monitor", "--format", "s16", "--rate", "44100", "--channels", "2", "-"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                )
                self.audio_proc = proc
                frame = 2048 * 2 * 2
                window = np.hanning(2048).astype(np.float32)
                while not self.stop_audio:
                    data = b""
                    while len(data) < frame and not self.stop_audio:
                        chunk = proc.stdout.read(frame - len(data))
                        if not chunk:
                            break
                        data += chunk
                    if len(data) < frame:
                        break
                    samples = np.frombuffer(data, dtype=np.int16).astype(np.float32)
                    samples = samples.reshape(-1, 2).mean(axis=1) * window
                    spec = np.abs(np.fft.rfft(samples))
                    edges = np.geomspace(2, max(3, len(spec) - 1), 33).astype(int)
                    peaks = []
                    for start, stop in zip(edges, edges[1:]):
                        stop = max(int(stop), int(start) + 1)
                        peaks.append(float(spec[start:stop].mean()))
                    loud = max(peaks) or 1.0
                    old = self.levels
                    self.levels = [
                        max(min(1.0, peak / loud), (old[index] if index < len(old) else 0) * 0.72)
                        for index, peak in enumerate(peaks)
                    ]
            except Exception:
                note_line("visual fell off the monitor, retrying")
                time.sleep(1)
            finally:
                if proc is not None and proc.poll() is None:
                    proc.kill()

    def show_art(self, url):
        if not url or url == self.art_url:
            return
        self.art_url = url

        def fetch():
            try:
                request = urllib.request.Request(url, headers={"User-Agent": "the-shit.music"})
                with urllib.request.urlopen(request, timeout=8) as response:
                    data = response.read()
                path = "/tmp/the-shit-music-art"
                with open(path, "wb") as handle:
                    handle.write(data)
            except Exception:
                return

            def apply():
                if url != self.art_url or self.art is None:
                    return False
                try:
                    texture = Gdk.Texture.new_from_filename(path)
                    self.art.set_paintable(texture)
                    if self.bar_art is not None:
                        self.bar_art.set_paintable(texture)
                except Exception:
                    note_failure()
                return False

            GLib.idle_add(apply)

        threading.Thread(target=fetch, daemon=True).start()

    def playlist_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        page.set_margin_top(18)
        page.set_margin_start(18)
        page.set_margin_end(18)
        page.set_vexpand(True)
        page.set_hexpand(True)
        self.playlist_title = Gtk.Label(label="Playlist", css_classes=["track"])
        self.playlist_title.set_halign(Gtk.Align.START)
        self.playlist_title.set_wrap(True)
        self.playlist_title.set_xalign(0)
        self.playlist_meta = Gtk.Label(label="", css_classes=["artist"])
        self.playlist_meta.set_halign(Gtk.Align.START)
        play = Gtk.Button(label="Play")
        play.set_halign(Gtk.Align.START)
        play.connect("clicked", self.on_play_selected)
        self.track_box = Gtk.FlowBox()
        self.track_box.set_selection_mode(Gtk.SelectionMode.NONE)
        self.track_box.set_min_children_per_line(1)
        self.track_box.set_max_children_per_line(3)
        self.track_box.set_homogeneous(True)
        self.track_box.set_column_spacing(24)
        self.track_box.set_row_spacing(0)
        self.track_box.set_hexpand(True)
        self.track_box.set_vexpand(True)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(self.track_box)
        scroll.set_vexpand(True)
        scroll.set_hexpand(True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page.append(self.playlist_title)
        page.append(self.playlist_meta)
        page.append(play)
        page.append(scroll)
        return page

    def load_playlists(self):
        try:
            playlists = account_playlists()
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            playlists = []
        if self.rail_box is None:
            return False
        while self.rail_box.get_first_child() is not None:
            self.rail_box.remove(self.rail_box.get_first_child())
        self.rails = {}
        self.hot_slots = []
        self.rail_button("playing", "Playing", "", self.show_playing)
        if not playlists:
            missing = Gtk.Label(label="No playlists", css_classes=["artist"])
            missing.set_margin_start(14)
            missing.set_halign(Gtk.Align.START)
            self.rail_box.append(missing)
            self.show_playing()
            return False
        for playlist in playlists:
            songs = playlist["count"]
            detail = f"{songs} song" if songs == 1 else f"{songs} songs"
            self.rail_button(
                playlist["uri"],
                playlist["name"],
                detail,
                lambda _button, item=playlist: self.show_playlist(item),
            )
        self.show_playing()
        self.name_add_button()
        return False

    def rail_button(self, key, title, detail, handler):
        button = Gtk.Button(css_classes=["rail"])
        lines = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        name = Gtk.Label(label=title, css_classes=["song"])
        name.set_xalign(0)
        name.set_hexpand(True)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_max_width_chars(36)
        lines.append(name)
        if detail:
            meta = Gtk.Label(label=detail, css_classes=["caption"])
            meta.set_xalign(0)
            meta.set_ellipsize(Pango.EllipsizeMode.END)
            lines.append(meta)
        button.set_child(lines)
        button.set_halign(Gtk.Align.FILL)
        button.set_hexpand(True)
        button.connect("clicked", handler)
        self.rail_box.append(button)
        self.rails[key] = button
        if len(self.hot_slots) < 10:
            number = "0" if len(self.hot_slots) == 9 else str(len(self.hot_slots) + 1)
            self.hot_slots.append((number, title, handler))

    def show_playing(self, *_args):
        self.selected = None
        self.mark_rail("playing")
        if self.stack is not None:
            self.stack.set_visible_child_name("playing")
        self.name_add_button()

    def show_playlist(self, playlist):
        self.selected = playlist
        self.mark_rail(playlist["uri"])
        if self.playlist_title is not None:
            self.playlist_title.set_label(playlist["name"])
            songs = playlist["count"]
            detail = f"{songs} song" if songs == 1 else f"{songs} songs"
            self.playlist_meta.set_label(detail)
        if self.stack is not None:
            self.stack.set_visible_child_name("playlist")
        self.name_add_button()
        self.clear_box(self.track_box)
        waiting = Gtk.Label(label="Loading songs", css_classes=["artist"])
        waiting.set_halign(Gtk.Align.START)
        self.track_box.append(waiting)
        GLib.idle_add(self.fill_tracks, playlist)

    def fill_tracks(self, playlist):
        if self.selected is None or self.selected.get("uri") != playlist["uri"]:
            return False
        try:
            rows = playlist_tracks(playlist["id"])
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            rows = []
        if self.selected is None or self.selected.get("uri") != playlist["uri"]:
            return False
        self.clear_box(self.track_box)
        if not rows:
            empty = Gtk.Label(label="No songs", css_classes=["artist"])
            empty.set_halign(Gtk.Align.START)
            self.track_box.append(empty)
            return False
        for row in rows:
            self.track_box.append(self.track_row(playlist, row))
        return False

    def track_row(self, playlist, row):
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, css_classes=["line"])
        line.set_hexpand(True)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        text.set_hexpand(True)
        name = Gtk.Label(label=row["name"], css_classes=["song"])
        name.set_xalign(0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_max_width_chars(42)
        artist = Gtk.Label(label=row["artist"], css_classes=["artist"])
        artist.set_xalign(0)
        artist.set_ellipsize(Pango.EllipsizeMode.END)
        text.append(name)
        text.append(artist)
        play = Gtk.Button(label="Play")
        play.connect("clicked", lambda _button, item=row: self.on_play_track(playlist, item))
        remove = Gtk.Button(label="Remove")
        remove.connect("clicked", lambda _button, item=row: self.on_remove_track(playlist, item))
        line.append(text)
        line.append(play)
        line.append(remove)
        return line

    def on_play_selected(self, _button):
        if not self.selected:
            return
        try:
            play_playlist(self.selected["uri"])
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't start that playlist")
            return
        self.say(f"Playing {self.selected['name']}")

    def on_play_track(self, playlist, row):
        try:
            start_on_thor({
                "context_uri": playlist["uri"],
                "offset": {"uri": row["uri"]},
            })
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't start that song")
            return
        self.say(f"Playing {row['name']}")

    def on_remove_track(self, playlist, row):
        try:
            removed = remove_from_playlist(playlist["id"], row["uri"])
        except urllib.error.HTTPError:
            self.say("Can't change this playlist")
            return
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't remove that")
            return
        if not removed:
            self.say("Couldn't remove that")
            return
        playlist["count"] = max(0, int(playlist.get("count") or 1) - 1)
        if self.playlist_meta is not None and self.selected and self.selected.get("uri") == playlist["uri"]:
            songs = playlist["count"]
            detail = f"{songs} song" if songs == 1 else f"{songs} songs"
            self.playlist_meta.set_label(detail)
        self.fill_tracks(playlist)
        self.say(f"Removed {row['name']}")

    def mark_rail(self, uri):
        for key, button in self.rails.items():
            if key == uri:
                button.add_css_class("selected")
            else:
                button.remove_css_class("selected")

    def clear_box(self, box):
        if box is None:
            return
        while box.get_first_child() is not None:
            box.remove(box.get_first_child())

    def name_add_button(self):
        if self.add_button is None:
            return
        if self.selected:
            self.add_button.set_label(f"Add to {self.selected['name']}")
        else:
            self.add_button.set_label("Add to playlist")

    def on_query_changed(self, entry):
        if self.search_timer:
            GLib.source_remove(self.search_timer)
            self.search_timer = 0
        text = entry.get_text().strip()
        if not text:
            self.results = []
            self.result_index = 0
            self.paint_results()
            return
        self.search_timer = GLib.timeout_add(220, lambda query=text: self.run_search(query))

    def run_search(self, query):
        self.search_timer = 0
        if self.search is None or self.search.get_text().strip() != query:
            return False
        try:
            self.results = search_catalog(query)
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.results = []
            self.say("Search failed")
        self.result_index = 0
        self.paint_results()
        return False

    def paint_results(self):
        if self.results_box is None or self.results_scroll is None:
            return
        self.clear_box(self.results_box)
        if not self.results:
            self.results_scroll.set_visible(False)
            return
        self.results_scroll.set_visible(True)
        for index, row in enumerate(self.results):
            button = Gtk.Button(css_classes=["rail"])
            if index == self.result_index:
                button.add_css_class("selected")
            label = Gtk.Label(label=f"{row['kind']}    {row['name']}    {row['detail']}")
            label.set_xalign(0)
            label.set_hexpand(True)
            label.set_ellipsize(Pango.EllipsizeMode.END)
            button.set_child(label)
            button.set_halign(Gtk.Align.FILL)
            button.connect("clicked", lambda _button, item=index: self.choose_result(item))
            self.results_box.append(button)

    def move_result(self, step):
        if not self.results:
            return
        self.result_index = (self.result_index + step) % len(self.results)
        self.paint_results()

    def selected_result(self):
        if not self.results:
            return None
        return self.results[min(self.result_index, len(self.results) - 1)]

    def choose_result(self, index):
        self.result_index = index
        self.paint_results()
        self.play_selected()

    def play_selected(self):
        row = self.selected_result()
        if row is None:
            self.say("Nothing matched")
            return
        try:
            if row["kind"] == "Track":
                play_in_album(row["track"])
                album = (row["track"].get("album") or {}).get("name") or "the album"
                self.say(f"Playing {row['name']} from {album}")
            elif row["kind"] == "Playlist":
                play_playlist(row["uri"])
                self.say(f"Playing {row['name']}")
            else:
                track = artist_top_track(row.get("artist_id") or "")
                if not track:
                    self.say(f"No songs for {row['name']}")
                    return
                play_in_album(track)
                self.say(f"Playing {track.get('name') or row['name']}")
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't start that")
            return
        GLib.timeout_add(700, self.paint_queue)

    def queue_selected(self):
        row = self.selected_result()
        if row is None or row["kind"] != "Track":
            self.say("Queue a track")
            return
        try:
            result = enqueue(row["uri"])
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't queue that")
            return
        if result == "already":
            self.say(f"{row['name']} is already queued")
        elif result == "added":
            self.say(f"Queued {row['name']}")
        GLib.timeout_add(700, self.paint_queue)

    def add_selected_to_playlist(self):
        row = self.selected_result()
        if row is None or row["kind"] != "Track":
            self.say("Add a track")
            return
        if not self.selected:
            self.say("Pick a playlist in the rail first")
            return
        try:
            added = add_to_playlist(self.selected["id"], row["uri"])
        except urllib.error.HTTPError:
            self.say(f"Can't change {self.selected['name']}")
            return
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't add that")
            return
        if not added:
            self.say("Couldn't add that")
            return
        self.selected["count"] = int(self.selected.get("count") or 0) + 1
        if self.playlist_meta is not None:
            songs = self.selected["count"]
            noun = "song" if songs == 1 else "songs"
            self.playlist_meta.set_label(f"{songs} {noun}")
        if self.stack is not None and self.stack.get_visible_child_name() == "playlist":
            self.fill_tracks(self.selected)
        self.say(f"Added {row['name']} to {self.selected['name']}")

    def on_search(self, _entry):
        self.play_selected()

    def on_search_key(self, _controller, keyval, _keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.search.set_text("")
            self.results = []
            self.paint_results()
            root = self.search.get_root()
            if root is not None:
                root.set_focus(None)
            return True
        if keyval == Gdk.KEY_Up:
            self.move_result(-1)
            return True
        if keyval == Gdk.KEY_Down:
            self.move_result(1)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and (
            state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK)
        ):
            self.queue_selected()
            return True
        return False

    def search_focused(self):
        return self.search is not None and self.search.has_focus()

    def bump_zoom(self, direction):
        self.set_zoom(self.scale + (ZOOM_STEP * direction))

    def set_zoom(self, scale):
        self.scale = min(ZOOM_MAX, max(ZOOM_MIN, scale))
        if self.provider is not None and self.colors is not None:
            self.provider.load_from_data(stylesheet(self.colors, self.scale))
        if self.zoom_label is not None:
            self.zoom_label.set_label(f"{round(self.scale * 100)}%")
        if self.rail_scroll is not None:
            self.rail_scroll.set_size_request(int(260 * self.scale), -1)
        try:
            os.makedirs(os.path.dirname(ZOOM_PATH), exist_ok=True)
            with open(ZOOM_PATH, "w", encoding="utf-8") as handle:
                handle.write(f"{self.scale:.2f}\n")
        except OSError:
            pass

    def on_zoom_scroll(self, controller, _dx, dy):
        state = controller.get_current_event_state()
        if not (state & Gdk.ModifierType.CONTROL_MASK) or dy == 0:
            return False
        self.bump_zoom(-1 if dy > 0 else 1)
        return True

    def on_window_key_release(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Alt_L, Gdk.KEY_Alt_R):
            self.set_hotkeys_visible(False)
        return False

    def on_window_key(self, _controller, keyval, _keycode, state):
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(state & Gdk.ModifierType.ALT_MASK)
        if keyval in (Gdk.KEY_Alt_L, Gdk.KEY_Alt_R):
            self.set_hotkeys_visible(True)
            return False
        if alt and not ctrl:
            number = None
            if Gdk.KEY_1 <= keyval <= Gdk.KEY_9:
                number = keyval - Gdk.KEY_1
            elif keyval == Gdk.KEY_0:
                number = 9
            if number is not None:
                self.activate_hot_slot(number)
                return True
        if ctrl and keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.bump_zoom(1)
            return True
        if ctrl and keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.bump_zoom(-1)
            return True
        if ctrl and keyval in (Gdk.KEY_0, Gdk.KEY_KP_0):
            self.set_zoom(1.25)
            return True
        if self.search_focused():
            return False
        if keyval == Gdk.KEY_slash or (ctrl and keyval == Gdk.KEY_f):
            if self.search is not None:
                self.search.grab_focus()
            return True
        if keyval == Gdk.KEY_space:
            self.on_toggle(None)
            return True
        if alt and keyval == Gdk.KEY_Left:
            self.on_previous(None)
            return True
        if alt and keyval == Gdk.KEY_Right:
            self.on_next(None)
            return True
        if keyval in (Gdk.KEY_q, Gdk.KEY_Q):
            self.queue_selected()
            return True
        if keyval in (Gdk.KEY_a, Gdk.KEY_A):
            self.add_selected_to_playlist()
            return True
        if keyval == Gdk.KEY_Escape:
            if self.results:
                self.results = []
                self.paint_results()
                if self.search is not None:
                    self.search.set_text("")
            elif self.stack is not None:
                self.show_playing()
            return True
        return False

    def say(self, text):
        if self.note is None:
            return
        self.note.set_label(text)
        if self.message_timer:
            GLib.source_remove(self.message_timer)
        def clear():
            if self.note is not None and self.note.get_label() == text:
                self.note.set_label("")
            self.message_timer = 0
            return False
        self.message_timer = GLib.timeout_add(2500, clear)

    def paint_queue(self):
        try:
            rows = upcoming()
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            return True
        if self.next_label is not None:
            self.next_label.set_label("Next   " + rows[0]["label"] if rows else "")
        return True

    def remember_workspace(self):
        try:
            clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
            active = json.loads(subprocess.check_output(["hyprctl", "activewindow", "-j"], text=True))
        except (OSError, json.JSONDecodeError):
            return True
        workspace = ""
        for client in clients:
            if client.get("class") == "the-shit.music":
                workspace = str((client.get("workspace") or {}).get("name") or "")
                break
        if not workspace:
            return True
        if self.seen_workspace is None:
            self.seen_workspace = workspace
            return True
        if workspace != self.seen_workspace:
            if (active or {}).get("class") == "the-shit.music":
                path = os.path.expanduser("~/.local/state/the-shit-music-workspace")
                try:
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(path, "w", encoding="utf-8") as handle:
                        handle.write(workspace + "\n")
                    note_line(f"home {workspace}")
                except OSError:
                    pass
            self.seen_workspace = workspace
        return True

    def on_close(self, _win):
        note_line("close-request")
        self.stop_audio = True
        if self.audio_proc is not None and self.audio_proc.poll() is None:
            self.audio_proc.kill()
        self.loop.quit()
        return False

    def on_realize(self, win):
        surface = win.get_native().get_surface()
        try:
            surface.set_application_id(APP_ID)
        except Exception:
            pass

    def refresh(self):
        try:
            props, _player = spotify()
            title, artist, album, play, state = meta_text(props)
            if self.title is not None:
                self.title.set_label(title)
                self.artist.set_label(artist)
                self.album.set_label(album)
                for button in self.play_buttons:
                    button.set_label(play)
                self.status.set_label(state)
            if self.bar_title is not None:
                self.bar_title.set_label(title)
                self.bar_artist.set_label(artist)
            if props is not None:
                metadata = props.Get("org.mpris.MediaPlayer2.Player", "Metadata")
                length = int(metadata.get("mpris:length") or 0)
                position = int(props.Get("org.mpris.MediaPlayer2.Player", "Position") or 0)
                self.track_length_ms = length
                fraction = min(1.0, position / length) if length else 0
                if self.progress is not None:
                    self.progress.set_fraction(fraction)
                if self.seek is not None and not self.seek.has_focus():
                    self.seek.set_value(fraction * 1000)
                if self.time_label is not None:
                    self.time_label.set_label(f"{clock(position)} / {clock(length)}")
                self.show_art(str(metadata.get("mpris:artUrl") or ""))
        except Exception:
            note_failure()
        return True

    def on_seek(self, _scale, _scroll, value):
        if self.track_length_ms:
            try:
                seek_to(self.track_length_ms * (float(value) / 1000))
            except (OSError, urllib.error.URLError, json.JSONDecodeError):
                self.say("Couldn't seek")
        return False

    def on_volume(self, _scale, _scroll, value):
        try:
            set_stream_volume(value)
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            self.say("Couldn't set volume")
        return False

    def on_previous(self, _button):
        _props, player = spotify()
        if player is not None:
            player.Previous()

    def on_next(self, _button):
        _props, player = spotify()
        if player is not None:
            player.Next()

    def on_toggle(self, _button):
        _props, player = spotify()
        if player is not None:
            player.PlayPause()
            GLib.timeout_add(200, self.refresh)


def main():
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    log = open(LOG_PATH, "a", encoding="utf-8")
    faulthandler.enable(log, all_threads=True)
    try:
        Music().run()
    except Exception:
        note_failure()
        raise


if __name__ == "__main__":
    main()
