        stage = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        stage.set_halign(Gtk.Align.CENTER)
        stage.set_valign(Gtk.Align.CENTER)
        stage.set_vexpand(True)
        stage.set_size_request(640, -1)

        self.art = Gtk.Picture()
        self.art.set_size_request(560, 560)
        self.art.set_hexpand(True)
        self.art.set_vexpand(True)
        self.art.set_can_shrink(True)
        self.art.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.title = Gtk.Label(label="Nothing playing", css_classes=["track"])
        self.title.set_halign(Gtk.Align.CENTER)
        self.title.set_justify(Gtk.Justification.CENTER)
        self.title.set_wrap(True)
        self.title.set_max_width_chars(22)
        self.artist = Gtk.Label(label="", css_classes=["song"])
        self.artist.set_halign(Gtk.Align.CENTER)
        self.album = Gtk.Label(label="", css_classes=["artist"])
        self.album.set_halign(Gtk.Align.CENTER)
        self.progress = Gtk.ProgressBar()
        self.progress.set_hexpand(True)
        self.progress.set_fraction(0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        actions.set_halign(Gtk.Align.CENTER)
        for label, handler in (
            ("Previous", self.on_previous),
            ("Play", self.on_toggle),
            ("Next", self.on_next),
        ):
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            actions.append(button)
            if label == "Play":
                self.play_buttons.append(button)
                self.play = button

        self.note = Gtk.Label(label="", css_classes=["artist"])
        self.note.set_halign(Gtk.Align.CENTER)
        self.next_label = Gtk.Label(label="", css_classes=["artist"])
        self.next_label.set_halign(Gtk.Align.CENTER)
        self.next_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.next_label.set_max_width_chars(48)

        for widget in (self.art, self.title, self.artist, self.album, self.progress, actions, self.note, self.next_label):
            stage.append(widget)
